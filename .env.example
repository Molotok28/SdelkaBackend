POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Строка подключения к PostgreSQL для приложения
# Пример: postgres://user:password@localhost:5432/sdelka?sslmode=disable
POSTGRES_DSN=

HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=5s

LOGGER_LEVEL=debug
LOGGER_FOLDER=out/logs

# Секрет для подписи JWT (минимум 32 символа, случайная строка)
JWT_SECRET=
# Время жизни токена (например: 24h, 168h)
JWT_TTL=24h
